<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional fallback: lets the app write the forced-shutter-sound setting
         directly when granted via adb. The primary path is Shizuku (see SettingsActivity);
         this permission is not required for normal use and is not granted automatically. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShutterMute"
        tools:targetApi="34">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ShutterMute">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShutterMuteTileService"
            android:exported="true"
            android:icon="@drawable/ic_shutter_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_TILE_SERVICE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
